{
  "name": "vew",
  "productName": "Vew",
  "version": "0.1.0",
  "description": "Vew, the browser for the Texor family",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fresh": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --universal",
    "dist:win": "electron-vite build && electron-builder --win --x64 --arm64",
    "dist:mac:unsigned": "electron-vite build && electron-builder --mac --universal -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "cmdk": "^1.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "author": {
    "name": "Texor",
    "email": "texor24x7@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/vew.git"
  }
}
